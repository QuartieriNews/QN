    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// staging_C update: canonical files -> Drive C Eventi, updating the file of the same name\n// (Drive keeps the previous revision) or uploading it when there is none. At most 300.\nconst files = ($('Webhook').first().json.body || {}).files;\nif (!Array.isArray(files) || files.length === 0 || files.length > 300) throw new Error('files: 1 to 300 required');\nconst ids = new Map();\nfor (const it of $input.all()) {\n  const n = it.json.name, id = it.json.id;\n  if (!n || !id) continue;\n  if (ids.has(n)) throw new Error('two files named ' + n + ' in C Eventi: fix by hand first');\n  ids.set(n, id);\n}\nconst seen = new Set();\nreturn files.map((f) => {\n  if (!/^roma__evt__[a-z0-9_.-]+\\.json$/.test(f.name)) throw new Error('bad file name: ' + f.name);\n  if (seen.has(f.name)) throw new Error('file listed twice: ' + f.name);\n  seen.add(f.name);\n  JSON.parse(f.content);\n  return { json: { name: f.name, fileId: ids.get(f.name) || null },\n    binary: { data: { data: Buffer.from(f.content, 'utf8').toString('base64'), mimeType: 'application/json', fileName: f.name } } };\n});"
      },
