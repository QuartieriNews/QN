      "parameters": {
        "jsCode": "// staging_C write: canonical files -> Drive C Eventi. Only spec file names, at most 100.\nconst files = ($json.body && Array.isArray($json.body.files)) ? $json.body.files : [];\nif (files.length === 0 || files.length > 100) throw new Error('files: 1 to 100 required');\nreturn files.map(f => {\n  if (!/^roma__evt__facebook__\\d+\\.json$/.test(f.name)) throw new Error('bad file name: ' + f.name);\n  JSON.parse(f.content);\n  return { json: { name: f.name }, binary: { data: { data: Buffer.from(f.content, 'utf8').toString('base64'), mimeType: 'application/json', fileName: f.name } } };\n});"
      },
